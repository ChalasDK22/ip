<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="420.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="eden.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true"
                    hbarPolicy="NEVER" vvalue="1.0"
                    AnchorPane.bottomAnchor="52.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true"
                      minHeight="0.0" prefWidth="418.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   promptText="Type a command..."
                   AnchorPane.bottomAnchor="6.0"
                   AnchorPane.leftAnchor="6.0"
                   AnchorPane.rightAnchor="92.0" />
        <Button mnemonicParsing="false" onAction="#handleUserInput"
                prefWidth="80.0" text="Send"
                AnchorPane.bottomAnchor="6.0"
                AnchorPane.rightAnchor="6.0" />
    </children>
</AnchorPane>
